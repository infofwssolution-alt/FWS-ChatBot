# Server configuration
PORT=3000

# MongoDB Connection String (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatbot_db?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chatbot_db?retryWrites=true&w=majority

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Upstash Redis REST credentials (get from https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Origin validation (comma-separated origins allowed to make requests, exact match, no wildcards)
# Include your test local URL and production client domains
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,https://client-site.com

# Rate limiting per session_id (rolling 1-hour window)
RATE_LIMIT_PER_HOUR=20
